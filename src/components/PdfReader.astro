---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<section class="pdf-reader" data-pdf-reader data-src={src}>
  <div class="pdf-toolbar" aria-label="PDF 阅读器工具栏">
    <div class="pdf-toolbar-group">
      <button type="button" data-action="previous" aria-label="上一页">←</button>
      <label>
        <span class="sr-only">当前页</span>
        <input data-page-input type="number" min="1" value="1" inputmode="numeric" />
      </label>
      <span>/ <span data-page-count>–</span></span>
      <button type="button" data-action="next" aria-label="下一页">→</button>
    </div>
    <div class="pdf-toolbar-title" title={title}>{title}</div>
    <div class="pdf-toolbar-group">
      <button type="button" data-action="zoom-out" aria-label="缩小">−</button>
      <span data-zoom-label>100%</span>
      <button type="button" data-action="zoom-in" aria-label="放大">＋</button>
      <a href={src} target="_blank" rel="noopener" aria-label="在新窗口打开原始 PDF">↗</a>
      <a href={src} download aria-label="下载 PDF">↓</a>
    </div>
  </div>
  <div class="pdf-stage" data-pdf-stage>
    <div class="pdf-loading" data-pdf-status>正在载入 PDF…</div>
    <canvas data-pdf-canvas aria-label={`《${title}》PDF 页面`}></canvas>
  </div>
</section>

<script>
  import * as pdfjs from 'pdfjs-dist';
  import workerSrc from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  pdfjs.GlobalWorkerOptions.workerSrc = workerSrc;

  document.querySelectorAll<HTMLElement>('[data-pdf-reader]').forEach((reader) => {
    const src = reader.dataset.src;
    const canvas = reader.querySelector<HTMLCanvasElement>('[data-pdf-canvas]');
    const stage = reader.querySelector<HTMLElement>('[data-pdf-stage]');
    const status = reader.querySelector<HTMLElement>('[data-pdf-status]');
    const pageInput = reader.querySelector<HTMLInputElement>('[data-page-input]');
    const pageCount = reader.querySelector<HTMLElement>('[data-page-count]');
    const zoomLabel = reader.querySelector<HTMLElement>('[data-zoom-label]');
    if (!src || !canvas || !stage || !status || !pageInput || !pageCount || !zoomLabel) return;

    let documentProxy: pdfjs.PDFDocumentProxy;
    let currentPage = 1;
    let zoom = 1;
    let rendering = false;
    let pendingPage: number | undefined;

    const showError = (message: string, error?: unknown) => {
      if (error) console.error(error);
      status.hidden = false;
      status.textContent = message;
      status.classList.add('error');
      rendering = false;
    };

    const renderPage = async (pageNumber: number) => {
      if (!documentProxy) return;
      if (rendering) {
        pendingPage = pageNumber;
        return;
      }

      try {
        rendering = true;
        const page = await documentProxy.getPage(pageNumber);
        const baseViewport = page.getViewport({ scale: 1 });
        const fitScale = Math.min(1.6, Math.max(0.35, (stage.clientWidth - 40) / baseViewport.width));
        const viewport = page.getViewport({ scale: fitScale * zoom });
        const ratio = window.devicePixelRatio || 1;
        const context = canvas.getContext('2d');
        if (!context) throw new Error('浏览器无法创建 Canvas 画布');

        canvas.width = Math.floor(viewport.width * ratio);
        canvas.height = Math.floor(viewport.height * ratio);
        canvas.style.width = `${viewport.width}px`;
        canvas.style.height = `${viewport.height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);

        await page.render({ canvas, canvasContext: context, viewport }).promise;
        currentPage = pageNumber;
        pageInput.value = String(currentPage);
        zoomLabel.textContent = `${Math.round(zoom * 100)}%`;
        status.hidden = true;
        rendering = false;

        if (pendingPage !== undefined) {
          const nextPage = pendingPage;
          pendingPage = undefined;
          void renderPage(nextPage);
        }
      } catch (error) {
        showError(`第 ${pageNumber} 页渲染失败，请尝试打开原始文件。`, error);
      }
    };

    const goToPage = (page: number) => {
      if (!documentProxy) return;
      void renderPage(Math.min(documentProxy.numPages, Math.max(1, page)));
    };

    reader.addEventListener('click', (event) => {
      const action = (event.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
      if (!action) return;
      if (action === 'previous') goToPage(currentPage - 1);
      if (action === 'next') goToPage(currentPage + 1);
      if (action === 'zoom-out') {
        zoom = Math.max(0.5, zoom - 0.15);
        goToPage(currentPage);
      }
      if (action === 'zoom-in') {
        zoom = Math.min(2.5, zoom + 0.15);
        goToPage(currentPage);
      }
    });

    pageInput.addEventListener('change', () => goToPage(Number(pageInput.value) || 1));

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => goToPage(currentPage), 150);
    });

    pdfjs.getDocument({ url: src }).promise
      .then((pdf) => {
        documentProxy = pdf;
        pageCount.textContent = String(pdf.numPages);
        pageInput.max = String(pdf.numPages);
        return renderPage(1);
      })
      .catch((error) => {
        showError('PDF 文件下载或解析失败，请尝试打开原始文件。', error);
      });
  });
</script>
