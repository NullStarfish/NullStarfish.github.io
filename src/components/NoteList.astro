---
import type { Note } from '../lib/notes';
import NoteCard from './NoteCard.astro';

interface Props {
  notes: Note[];
  empty?: string;
}

const { notes, empty = '这里还没有公开笔记。' } = Astro.props;
---

{notes.length > 0 ? (
  <div class="note-grid">
    {notes.map((note) => <NoteCard note={note} />)}
  </div>
) : (
  <div class="empty-state">
    <span aria-hidden="true">◌</span>
    <p>{empty}</p>
  </div>
)}
