---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import NoteList from '../components/NoteList.astro';
import { getPublishedNotes, groupCounts, topicHref } from '../lib/notes';

const notes = await getPublishedNotes();
const featured = notes.filter((note) => note.featured).slice(0, 3);
const recent = notes.slice(0, 6);
const topics = groupCounts(notes.map((note) => note.topic)).slice(0, 6);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="kicker">PERSONAL NOTES · 个人知识花园</p>
      <h1>把学到的东西，<br /><em>一点点连成星图。</em></h1>
      <p class="hero-lead">
        你好，我是 Null Starfish。这里收集我的学习笔记、思考碎片，以及那些值得反复回看的问题。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/notes/">浏览全部笔记 <span aria-hidden="true">→</span></a>
        <a class="button quiet" href="/about/">关于这个网站</a>
      </div>
    </div>
    <div class="hero-orbit" aria-hidden="true">
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
      <span class="star star-one">✦</span>
      <span class="star star-two">·</span>
      <span class="star star-three">✧</span>
      <span class="orbit-label">LEARN<br />CONNECT<br />GROW</span>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading split-heading">
      <div>
        <p class="kicker">TOPICS</p>
        <h2>学习主题</h2>
      </div>
      <p>主题是知识的入口，标签让不同领域彼此相遇。</p>
    </div>
    {topics.length > 0 ? (
      <div class="topic-grid">
        {topics.map((topic, index) => (
          <a class="topic-card" href={topicHref(topic.name)}>
            <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
            <strong>{topic.name}</strong>
            <span>{topic.count} 篇笔记</span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state"><span aria-hidden="true">◌</span><p>公开第一篇笔记后，主题会出现在这里。</p></div>
    )}
  </section>

  {featured.length > 0 && (
    <section class="section section-tinted">
      <div class="shell">
        <div class="section-heading">
          <p class="kicker">FEATURED</p>
          <h2>精选笔记</h2>
        </div>
        <div class="featured-grid">
          {featured.map((note) => <NoteCard note={note} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section shell">
    <div class="section-heading split-heading">
      <div>
        <p class="kicker">RECENTLY UPDATED</p>
        <h2>最近更新</h2>
      </div>
      <a class="text-link" href="/notes/">查看全部 <span aria-hidden="true">→</span></a>
    </div>
    <NoteList notes={recent} empty="公开第一篇笔记后，它会出现在这里。" />
  </section>
</BaseLayout>
