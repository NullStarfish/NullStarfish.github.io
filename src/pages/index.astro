---
import ProjectCard from "@components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getPostUrlBySlug, url } from "../utils/url-utils";
import { getSortedPosts } from "../utils/content-utils";

const posts = (await getSortedPosts()).filter(post => !post.data.draft);
const recentPosts = posts.slice(0, 4);
const projects = (await getCollection("projects", ({ data }) => !data.draft && data.entryType === 'project'))
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.published.valueOf() - a.data.published.valueOf());
const featuredProjects = projects.slice(0, 4);
const categories = new Set(posts.map(post => post.data.category).filter(Boolean));
---

<MainGridLayout description="Null Starfish 的个人主页、项目档案与技术博客。">
	<section class="grid lg:grid-cols-[minmax(0,1fr)_15rem] gap-6 lg:gap-8 items-start pb-12 md:pb-16">
		<div>
			<p class="text-sm font-bold tracking-widest uppercase text-[var(--primary)] mb-5">Engineer · Learner · Builder</p>
			<h1 class="text-4xl md:text-6xl leading-tight tracking-tight font-bold text-90 mb-7">
				你好，我是<br /><span class="text-[var(--primary)]">Null Starfish.</span>
			</h1>
			<p class="text-lg md:text-xl leading-8 text-75 max-w-2xl mb-8">
				我在这里记录技术上的碎碎念
			</p>
			<div class="flex flex-wrap gap-3">
				<a href={url("/projects/")} class="btn-regular rounded-xl px-5 h-12 font-bold bg-[var(--primary)] !text-white hover:brightness-110">查看项目</a>
				<a href={url("/blog/")} class="btn-regular rounded-xl px-5 h-12 font-bold">阅读文章</a>
				<a href="https://github.com/NullStarfish" target="_blank" rel="noopener" class="btn-regular rounded-xl w-12 h-12" aria-label="GitHub">
					<Icon name="fa6-brands:github" class="text-xl" />
				</a>
			</div>
		</div>
		<div class="card-base rounded-[var(--radius-large)] p-3">
			<dl class="grid grid-cols-3 divide-x divide-black/10 dark:divide-white/10 text-center">
				<div class="px-2 py-3"><dt class="text-xs text-50 mb-1">文章</dt><dd class="text-xl font-bold text-90">{posts.length}</dd></div>
				<div class="px-2 py-3"><dt class="text-xs text-50 mb-1">领域</dt><dd class="text-xl font-bold text-90">{categories.size}</dd></div>
				<div class="px-2 py-3"><dt class="text-xs text-50 mb-1">项目</dt><dd class="text-xl font-bold text-90">{projects.length}</dd></div>
			</dl>
		</div>
	</section>

	<section class="py-12 md:py-16">
		<div class="flex items-end justify-between gap-4 mb-7">
			<div><p class="text-sm font-bold text-[var(--primary)] mb-2">Selected work</p><h2 class="text-2xl md:text-3xl font-bold text-90">项目与实践</h2></div>
			<a href={url("/projects/")} class="text-sm font-medium text-[var(--primary)] hover:underline">全部项目 →</a>
		</div>
		<div class="grid md:grid-cols-2 gap-5">
			{featuredProjects.map(project => <ProjectCard project={project} compact />)}
		</div>
	</section>

	<section class="py-12 md:py-16">
		<div class="flex items-end justify-between gap-4 mb-7">
			<div><p class="text-sm font-bold text-[var(--primary)] mb-2">Latest notes</p><h2 class="text-2xl md:text-3xl font-bold text-90">最近在写</h2></div>
			<a href={url("/blog/")} class="text-sm font-medium text-[var(--primary)] hover:underline">全部文章 →</a>
		</div>
		<div class="card-base rounded-[var(--radius-large)] overflow-hidden">
			{recentPosts.map(post => (
				<a href={getPostUrlBySlug(post.slug)} class="group grid md:grid-cols-[8rem_1fr_auto] gap-2 md:gap-6 items-center px-5 md:px-7 py-5 border-b border-black/[.06] dark:border-white/[.08] last:border-0 hover:bg-black/[.02] dark:hover:bg-white/[.03] transition">
					<div class="text-xs text-50">{post.data.published.toLocaleDateString("zh-CN")}</div>
					<div><h3 class="font-bold text-lg group-hover:text-[var(--primary)] transition">{post.data.title}</h3><p class="text-sm text-50 mt-1 line-clamp-1">{post.data.description}</p></div>
					<Icon name="material-symbols:arrow-forward-rounded" class="hidden md:block text-xl text-50 group-hover:text-[var(--primary)] group-hover:translate-x-1 transition" />
				</a>
			))}
		</div>
	</section>

	<section class="card-base rounded-[var(--radius-large)] p-7 md:p-10 my-12 md:my-16 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
		<div><p class="text-sm font-bold text-[var(--primary)] mb-2">Now</p><h2 class="text-2xl md:text-3xl font-bold mb-3">把理解变成可以复用的东西</h2><p class="text-75 max-w-2xl">这个网站既是学习档案，也是项目实验场。欢迎从文章开始，也可以去 GitHub 看看正在发生的事情。</p></div>
		<a href={url("/about/")} class="btn-regular rounded-xl px-5 h-12 font-bold whitespace-nowrap">关于我</a>
	</section>
</MainGridLayout>
