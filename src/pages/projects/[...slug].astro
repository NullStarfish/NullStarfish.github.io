---
import Markdown from "@components/misc/Markdown.astro";
import ProjectTreeNav from "@components/ProjectTreeNav.astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getProjectUrlById, normalizeContentSlug, url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);
	return projects.map(project => ({ params: { slug: normalizeContentSlug(project.id) }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, status, repository, demo, published, updated, image } = project.data;
const statusLabel = { active: "持续迭代", completed: "已完成", archived: "已归档" }[status];
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const rootId = project.data.parentProject || normalizeContentSlug(project.id);
const root = allProjects.find((entry) => normalizeContentSlug(entry.id) === rootId && entry.data.entryType === "project") || project;
const chapters = allProjects
	.filter((entry) => entry.data.entryType === "chapter" && entry.data.parentProject === rootId)
	.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, "zh-CN"));
const chapterIndex = chapters.findIndex((entry) => entry.id === project.id);
const previous = chapterIndex > 0 ? chapters[chapterIndex - 1] : undefined;
const next = chapterIndex >= 0 && chapterIndex < chapters.length - 1 ? chapters[chapterIndex + 1] : undefined;
---

<MainGridLayout title={title} description={summary}>
	<a href={url("/projects/")} class="inline-flex items-center gap-2 text-sm text-75 hover:text-[var(--primary)] mb-8"><Icon name="material-symbols:arrow-back-rounded" />返回项目</a>
	<nav aria-label="面包屑" class="flex flex-wrap items-center gap-2 text-sm text-75 mb-8">
		<a href={url("/projects/")} class="hover:text-[var(--primary)]">项目</a>
		<Icon name="material-symbols:chevron-right-rounded" />
		{project.data.entryType === "chapter" && <><a href={getProjectUrlById(root.id)} class="hover:text-[var(--primary)]">{root.data.navTitle || root.data.title}</a><Icon name="material-symbols:chevron-right-rounded" /></>}
		<span class="text-90">{project.data.navTitle || title}</span>
	</nav>
	<div class:list={[chapters.length ? "grid md:grid-cols-[17rem_minmax(0,1fr)] gap-6 items-start" : ""]}>
		{chapters.length > 0 && <ProjectTreeNav root={root} chapters={chapters} currentId={project.id} />}
	<article class="card-base rounded-[var(--radius-large)] overflow-hidden mb-12 min-w-0">
		{image && (
			<div id="project-cover" class="relative border-b border-black/[.06] dark:border-white/[.08]">
				<img src={url(image)} alt={`${title} 项目封面`} class="w-full max-h-[34rem] object-cover" />
			</div>
		)}
		<header class="px-6 md:px-10 pt-9 md:pt-12 pb-9 border-b border-black/[.06] dark:border-white/[.08]">
			<div class="flex flex-wrap items-center gap-3 mb-6 text-xs">
				<span class="rounded-full px-3 py-1 bg-[var(--primary)]/10 text-[var(--primary)] font-medium">{statusLabel}</span>
				<span class="text-50">{published.toLocaleDateString("zh-CN")}{updated && ` · 更新于 ${updated.toLocaleDateString("zh-CN")}`}</span>
			</div>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-90 mb-5">{title}</h1>
			<p class="text-lg md:text-xl leading-8 text-75 max-w-3xl mb-6">{summary}</p>
			<div class="flex flex-wrap gap-2 mb-7">{tags.map(tag => <span class="rounded-lg bg-black/[.04] dark:bg-white/[.07] px-2.5 py-1 text-xs text-75">{tag}</span>)}</div>
			<div class="flex flex-wrap gap-3">
				{repository && <a href={repository} target="_blank" rel="noopener" class="btn-regular rounded-xl px-4 h-11 font-bold gap-2"><Icon name="fa6-brands:github" />查看源码</a>}
				{demo && <a href={demo} target="_blank" rel="noopener" class="btn-regular rounded-xl px-4 h-11 font-bold gap-2">在线访问<Icon name="material-symbols:arrow-outward-rounded" /></a>}
			</div>
		</header>
		<div class="px-6 md:px-10 py-9 md:py-12 max-w-4xl">
			<Markdown class="mt-0"><Content /></Markdown>
		</div>
		{project.data.entryType === "chapter" && (
			<footer class="grid sm:grid-cols-2 border-t border-black/[.06] dark:border-white/[.08]">
				<div class="p-6 border-b sm:border-b-0 sm:border-r border-black/[.06] dark:border-white/[.08]">
					{previous ? <a href={getProjectUrlById(previous.id)} class="block hover:text-[var(--primary)]"><span class="block text-xs text-50 mb-1">上一篇</span><strong>{previous.data.navTitle || previous.data.title}</strong></a> : <a href={getProjectUrlById(root.id)} class="block hover:text-[var(--primary)]"><span class="block text-xs text-50 mb-1">返回</span><strong>项目总览</strong></a>}
				</div>
				<div class="p-6 text-right">
					{next ? <a href={getProjectUrlById(next.id)} class="block hover:text-[var(--primary)]"><span class="block text-xs text-50 mb-1">下一篇</span><strong>{next.data.navTitle || next.data.title}</strong></a> : <a href={getProjectUrlById(root.id)} class="block hover:text-[var(--primary)]"><span class="block text-xs text-50 mb-1">返回</span><strong>项目总览</strong></a>}
				</div>
			</footer>
		)}
	</article>
	</div>
</MainGridLayout>
