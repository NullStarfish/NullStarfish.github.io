---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfReader from '../../components/PdfReader.astro';
import { formatFileSize, getBooks, type Book } from '../../lib/books';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<BaseLayout title={book.title} description={book.description} noindex>
  <header class="reader-header shell">
    <div>
      <a class="eyebrow" href="/library/">← 返回书架</a>
      <h1>{book.title}</h1>
      <p>{book.author ? `${book.author} · ` : ''}{formatFileSize(book.size)}</p>
    </div>
    {book.tags.length > 0 && (
      <ul class="tag-list" aria-label="书籍标签">
        {book.tags.map((tag) => <li><a href={`/library/?tag=${encodeURIComponent(tag)}`}>#{tag}</a></li>)}
      </ul>
    )}
  </header>
  <div class="reader-shell shell">
    <PdfReader src={book.fileUrl} title={book.title} />
  </div>
</BaseLayout>
