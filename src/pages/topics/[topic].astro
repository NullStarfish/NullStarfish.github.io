---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { getPublishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const topics = [...new Set(notes.map((note) => note.topic))];
  return topics.map((topic) => ({
    params: { topic },
    props: { topic, notes: notes.filter((note) => note.topic === topic) },
  }));
}

const { topic, notes } = Astro.props;
---

<BaseLayout title={`主题：${topic}`} description={`“${topic}”主题下的学习笔记。`}>
  <header class="page-hero shell">
    <p class="kicker">TOPIC</p>
    <h1>{topic}</h1>
    <p>{notes.length} 篇公开笔记</p>
  </header>
  <section class="section shell">
    <NoteList notes={notes} />
  </section>
</BaseLayout>
