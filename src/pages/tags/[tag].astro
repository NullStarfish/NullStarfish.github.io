---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { getPublishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const tags = [...new Set(notes.flatMap((note) => note.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, notes: notes.filter((note) => note.tags.includes(tag)) },
  }));
}

const { tag, notes } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`带有“${tag}”标签的学习笔记。`}>
  <header class="page-hero shell">
    <p class="kicker">TAG</p>
    <h1>#{tag}</h1>
    <p>{notes.length} 篇公开笔记</p>
  </header>
  <section class="section shell">
    <NoteList notes={notes} />
  </section>
</BaseLayout>
